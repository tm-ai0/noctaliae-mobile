# ⚙️ CONFIGURATION DÉPLOIEMENT NOCTALIÆ
# Copier ce fichier en config.env et remplir les valeurs

# 🌐 Connexion SSH Infomaniak
SSH_HOST=your-server.infomaniak.com
SSH_PORT=22
SSH_USER=your-username
SSH_KEY_PATH=~/.ssh/id_rsa

# 📂 Chemins Backend sur le serveur
BACKEND_DIR=/path/to/backend
BACKEND_FILE=app.py
BACKUP_DIR=/path/to/backups

# 🔧 Service Backend
SERVICE_NAME=noctaliae-backend
RESTART_COMMAND="systemctl restart noctaliae-backend"

# 🧪 API Testing
API_URL=https://your-api-url.com/chat-text
TEST_MESSAGE="J'ai rêvé que je volais"

# 📝 Prompt
PROMPT_FILE=../PROMPT_SCIENTIFIQUE_ARNULF.md
