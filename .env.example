# ============================================
# 🌙 NOCTALIÆ - VARIABLES D'ENVIRONNEMENT
# ============================================
# Copie ce fichier en .env et remplis les valeurs

# ============================================
# BACKEND API
# ============================================
API_BASE_URL=https://api.thomasmaury.fr

# ============================================
# MONITORING & ANALYTICS
# ============================================

# Sentry (Crash Reporting)
# Gratuit jusqu'à 5000 errors/mois
# https://sentry.io
SENTRY_DSN=

# Amplitude (Analytics)
# Gratuit jusqu'à 10M events/mois
# https://amplitude.com
AMPLITUDE_API_KEY=

# ============================================
# PREMIUM (À VENIR)
# ============================================

# Stripe
# https://stripe.com
STRIPE_PUBLISHABLE_KEY=

# ============================================
# NOTES
# ============================================

# Les clés API pour Claude, Groq, OpenAI sont sur le backend
# Elles ne doivent JAMAIS être dans l'app mobile

# Pour obtenir les clés :
# 1. Sentry : https://sentry.io/settings/YOUR_ORG/projects/noctaliae/keys/
# 2. Amplitude : https://analytics.amplitude.com/YOUR_ORG/settings/projects/YOUR_PROJECT/general

# Une fois configurées, redémarre l'app :
# npm start -- --clear
