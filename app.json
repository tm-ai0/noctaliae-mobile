{
  "expo": {
    "name": "Noctaliae",
    "slug": "noctaliae-mobile",
    "version": "0.9.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0b2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noctaliae.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Noctaliae a besoin du microphone pour enregistrer vos reves.",
        "NSSpeechRecognitionUsageDescription": "Noctaliae utilise la reconnaissance vocale.",
        "NSFaceIDUsageDescription": "Noctaliae utilise Face ID pour proteger vos reves secrets."
      }
    },
    "android": {
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a0b2e"
      },
      "package": "com.noctaliae.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Permettre a Noctaliae d'enregistrer vos reves."
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Utiliser Face ID pour acceder a vos reves proteges."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2f45576d-d20a-49af-b612-fd007ee3c352"
      }
    }
  }
}
